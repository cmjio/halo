{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Static files from site/dist, served at halolang.com. worker.ts runs first only to
  // redirect other hostnames (www, workers.dev) to halolang.com.
  "name": "halo-showcase",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-20",
  // Kept on so the first address, halo-showcase.cmj.workers.dev, redirects to halolang.com.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "halolang.com", "custom_domain": true },
    { "pattern": "www.halolang.com", "custom_domain": true }
  ],
  // Release binaries (too big for static assets), served at /dl/ by worker.ts.
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "halo-releases" }],
  // One data point per binary downloaded from /dl (worker.ts countDownload). The dataset is
  // created on first write; read it with `bun scripts/install-stats.ts`.
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "halo_downloads" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
