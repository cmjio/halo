# ── Required ──
# The model provider (swap the model in pipelines/chat.halo to use another).
ANTHROPIC_API_KEY=
# Your Postgres. A read-only database user is best: Chat only ever runs SELECT.
DATABASE_URL=postgres://chat_readonly:password@localhost:5432/shop
# Your backend calls the chat with this token (Authorization: Bearer ...). openssl rand -hex 24
HALO_SERVE_TOKEN=

# ── Hand-offs in Slack ──
# A Slack app's bot token (chat:write), and the channel your support team watches (invite the bot).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#support

# ── Serving on the internet ──
HALO_PUBLIC_URL=
