# ── Required ──
# The model provider (swap the models in pipelines/support.halo to use another).
ANTHROPIC_API_KEY=
# Resend (resend.com) sends the replies. SUPPORT_FROM must be on a domain verified there.
RESEND_API_KEY=
SUPPORT_FROM=support@yourcompany.com
# Inbound email posts to /hooks/email?secret=<this>. Make one with: openssl rand -hex 24
INBOUND_WEBHOOK_SECRET=

# ── Serving on the internet ──
# Needed to listen on anything but localhost: protects /api, /mcp and Studio. openssl rand -hex 24
HALO_SERVE_TOKEN=
# Where people reach this server; approval links use it (e.g. https://support-inbox.fly.dev).
HALO_PUBLIC_URL=

# ── Optional: Slack ──
# An incoming-webhook URL: each draft waiting for review is posted there with its approval link.
SLACK_WEBHOOK_URL=
# Your Slack app's signing secret, for Approve / Reject buttons (also add it to halo.json, see README).
SLACK_SIGNING_SECRET=
