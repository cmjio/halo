# ── Required ──
# The model provider (swap the model in pipelines/fix.halo to use another).
ANTHROPIC_API_KEY=
# The repository to fix issues in, as owner/name.
GITHUB_REPO=acme/shop
# A fine-grained token for GITHUB_REPO with Contents: read and write, Issues: read and write,
# and Pull requests: read and write. It reads issues, pushes halo/issue-* branches, and opens PRs.
GITHUB_TOKEN=

# ── The sandbox ──
# "auto" uses Docker when it's running here. Where there's no Docker (Fly, Render, Railway),
# set one of these. E2B is what the Dockerfile and fly.toml expect.
E2B_API_KEY=
DAYTONA_API_KEY=

# ── Serving on the internet ──
# The GitHub webhook's secret (GitHub signs each delivery with it). openssl rand -hex 24
GITHUB_WEBHOOK_SECRET=
# Needed to listen on anything but localhost: protects /api, /mcp and Studio. openssl rand -hex 24
HALO_SERVE_TOKEN=
# Where people reach this server; approval links use it (e.g. https://fix-issue.fly.dev).
HALO_PUBLIC_URL=

# ── Optional: Slack ──
# An incoming-webhook URL: each diff waiting for review is posted there with its approval link.
SLACK_WEBHOOK_URL=
