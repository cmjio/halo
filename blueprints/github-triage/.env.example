# ── Required ──
# The model provider (swap the models in pipelines/triage.halo to use another).
ANTHROPIC_API_KEY=
# A fine-grained token for your repos with Issues: read and write (labels, comments).
GITHUB_TOKEN=
# The secret you give GitHub's webhook. Make one with: openssl rand -hex 24
GITHUB_WEBHOOK_SECRET=

# ── Weekly report in Slack ──
# A Slack app's bot token (chat:write), and the channel it posts to (invite the bot).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#maintainers

# ── Serving on the internet ──
# Needed to listen on anything but localhost: protects /api, /mcp and Studio. openssl rand -hex 24
HALO_SERVE_TOKEN=
# Where people reach this server; approval links use it (e.g. https://github-triage.fly.dev).
HALO_PUBLIC_URL=

# ── Optional ──
# An incoming-webhook URL: each comment waiting for approval is posted there with its link.
SLACK_WEBHOOK_URL=
