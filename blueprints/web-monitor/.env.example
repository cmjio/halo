# ── Required ──
# The model provider (swap the models in pipelines/monitor.halo to use another).
ANTHROPIC_API_KEY=
# Resend (resend.com) sends the digest. DIGEST_FROM must be on a domain verified there.
RESEND_API_KEY=
DIGEST_FROM=monitor@yourcompany.com
DIGEST_TO=team@yourcompany.com

# ── Serving on the internet ──
# Needed to listen on anything but localhost: protects /api, /mcp and Studio. openssl rand -hex 24
HALO_SERVE_TOKEN=
HALO_PUBLIC_URL=
