# ── Required ──
# The model provider (swap the model in pipelines/incidents.halo to use another).
ANTHROPIC_API_KEY=
# Sentry: an internal integration's token (Issue & Event: read). Its webhook URL ends ?secret=<SENTRY_WEBHOOK_SECRET>.
SENTRY_AUTH_TOKEN=
SENTRY_WEBHOOK_SECRET=
# GitHub: a fine-grained token with Contents: read on the repo in halo.json.
GITHUB_TOKEN=
# Linear: a personal API key, and the key of the team that gets the issues.
LINEAR_TOKEN=
LINEAR_TEAM=ENG
# Slack: a bot token (chat:write), and the channel it posts to (invite the bot).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#incidents

# ── Serving on the internet ──
# Needed to listen on anything but localhost: protects /api, /mcp and Studio. openssl rand -hex 24
HALO_SERVE_TOKEN=
HALO_PUBLIC_URL=
