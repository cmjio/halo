%YAML 1.2
---
name: Langly
file_extensions: [ly]
scope: source.langly

contexts:
  main:
    - include: comment
    - include: mind-decl
    - include: stream-decl

  comment:
    - match: "//"
      scope: punctuation.definition.comment.langly
      push: comment-body

  comment-body:
    - meta_scope: comment.line.double-slash.langly
    - match: $\n?
      pop: true

  mind-decl:
    - match: '\b(mind)\b\s+([a-zA-Z_][a-zA-Z0-9_]*)'
      captures:
        1: storage.type.langly
        2: entity.name.type.mind.langly
      push: mind-config

  mind-config:
    - meta_scope: meta.mind-config.langly
    - match: '\['
      scope: punctuation.section.brackets.begin.langly
      set: model-config-inner
    - match: ''
      pop: true

  model-config-inner:
    - meta_scope: meta.model-config.langly
    - match: '\]'
      scope: punctuation.section.brackets.end.langly
      pop: true
    - match: '/'
    - include: model-ref
    - include: param-pair
    - include: literal
    - match: ','
      scope: punctuation.separator.langly

  model-ref:
    - match: '(/?)([a-zA-Z_][a-zA-Z0-9_]*)([\-/]([a-zA-Z0-9_-]+))*'
      scope: entity.name.model.langly

  param-pair:
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(:)'
      captures:
        1: variable.parameter.langly
        2: keyword.operator.assignment.langly

  stream-decl:
    - match: '\b(stream)\b'
      captures:
        1: storage.type.langly
      push: stream-signature

  stream-signature:
    - meta_scope: meta.stream-signature.langly
    - include: comment
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(\()'
      captures:
        1: entity.name.function.stream.langly
        2: punctuation.section.parens.begin.langly
      push: stream-params
    - match: '->'
      scope: keyword.operator.arrow.langly
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
      scope: entity.name.type.langly
    - match: ':'
      scope: punctuation.section.block.begin.langly
      set: stream-body

  stream-params:
    - meta_scope: meta.stream-params.langly
    - include: comment
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b\s*(:)\s*\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
      captures:
        1: variable.parameter.langly
        2: keyword.operator.assignment.langly
        3: entity.name.type.langly
    - match: ','
      scope: punctuation.separator.langly
    - match: '\)'
      scope: punctuation.section.parens.end.langly
      pop: true

  stream-body:
    - include: comment
    - match: '\|>'
      scope: keyword.operator.pipe.langly
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\s*\.\\s*([a-zA-Z_][a-zA-Z0-9_]*)'
      captures:
        1: variable.other.object.langly
        2: entity.name.function.call.langly
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
      scope: variable.other.langly
    - include: call-args
    - include: literal

  call-args:
    - match: '\('
      scope: punctuation.section.parens.begin.langly
      push: call-args-inner

  call-args-inner:
    - meta_scope: meta.call-args.langly
    - include: comment
    - match: '\)'
      scope: punctuation.section.parens.end.langly
      pop: true
    - match: ','
      scope: punctuation.separator.langly
    - include: literal

  literal:
    - include: string
    - include: number
    - include: boolean

  string:
    - match: '"'
      scope: punctuation.definition.string.begin.langly
      push: string-double-body

  string-double-body:
    - meta_scope: string.quoted.double.langly
    - match: '\\([\"\'/\\nrt]|.)'
      scope: constant.character.escape.langly
    - match: '"'
      scope: punctuation.definition.string.end.langly
      pop: true
    - match: '\n'
      pop: true

    - match: "'"
      scope: punctuation.definition.string.begin.langly
      push: string-single-body

  string-single-body:
    - meta_scope: string.quoted.single.langly
    - match: '\\(["\'/\\nrt]|.)'
      scope: constant.character.escape.langly
    - match: "'"
      scope: punctuation.definition.string.end.langly
      pop: true
    - match: '\n'
      pop: true

  number:
    - match: '\b-?[0-9]+(\.[0-9]+)?\b'
      scope: constant.numeric.langly

  boolean:
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.langly
