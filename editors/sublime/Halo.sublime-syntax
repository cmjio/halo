%YAML 1.2
---
name: Halo
file_extensions: [halo]
scope: source.halo

contexts:
  main:
    - include: comment
    - include: keywords
    - include: agent-decl
    - include: pipeline-decl

  comment:
    - match: "//"
      scope: punctuation.definition.comment.halo
      push: comment-body

  comment-body:
    - meta_scope: comment.line.double-slash.halo
    - match: $\n?
      pop: true

  agent-decl:
    - match: '\b(agent)\b\s+([a-zA-Z_][a-zA-Z0-9_]*)'
      captures:
        1: storage.type.halo
        2: entity.name.type.agent.halo
      push: agent-config

  agent-config:
    - meta_scope: meta.agent-config.halo
    - match: '\['
      scope: punctuation.section.brackets.begin.halo
      set: model-config-inner
    - match: ''
      pop: true

  model-config-inner:
    - meta_scope: meta.model-config.halo
    - match: '\]'
      scope: punctuation.section.brackets.end.halo
      pop: true
    - match: '/'
    - include: model-ref
    - include: param-pair
    - include: literal
    - match: ','
      scope: punctuation.separator.halo

  model-ref:
    - match: '(/?)([a-zA-Z_][a-zA-Z0-9_]*)([\-/]([a-zA-Z0-9_-]+))*'
      scope: entity.name.model.halo

  param-pair:
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(:)'
      captures:
        1: variable.parameter.halo
        2: keyword.operator.assignment.halo

  pipeline-decl:
    - match: '\b(pipeline)\b'
      captures:
        1: storage.type.halo
      push: pipeline-signature

  pipeline-signature:
    - meta_scope: meta.pipeline-signature.halo
    - include: comment
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(\()'
      captures:
        1: entity.name.function.pipeline.halo
        2: punctuation.section.parens.begin.halo
      push: pipeline-params
    - match: '->'
      scope: keyword.operator.arrow.halo
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
      scope: entity.name.type.halo
    - match: ':'
      scope: punctuation.section.block.begin.halo
      set: pipeline-body

  pipeline-params:
    - meta_scope: meta.pipeline-params.halo
    - include: comment
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b\s*(:)\s*\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
      captures:
        1: variable.parameter.halo
        2: keyword.operator.assignment.halo
        3: entity.name.type.halo
    - match: ','
      scope: punctuation.separator.halo
    - match: '\)'
      scope: punctuation.section.parens.end.halo
      pop: true

  pipeline-body:
    - include: comment
    - include: keywords
    - include: string
    - match: '\|>'
      scope: keyword.operator.pipe.halo
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\s*\.\\s*([a-zA-Z_][a-zA-Z0-9_]*)'
      captures:
        1: variable.other.object.halo
        2: entity.name.function.call.halo
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\b'
      scope: variable.other.halo
    - include: call-args
    - include: literal

  call-args:
    - match: '\('
      scope: punctuation.section.parens.begin.halo
      push: call-args-inner

  call-args-inner:
    - meta_scope: meta.call-args.halo
    - include: comment
    - include: keywords
    - match: '\)'
      scope: punctuation.section.parens.end.halo
      pop: true
    - match: ','
      scope: punctuation.separator.halo
    - include: literal

  literal:
    - include: string
    - include: number
    - include: boolean

  string:
    - match: '"""'
      scope: punctuation.definition.string.begin.halo
      push: triple-string-body
    - match: '"'
      scope: punctuation.definition.string.begin.halo
      push: string-double-body
    - match: "'"
      scope: punctuation.definition.string.begin.halo
      push: string-single-body

  string-double-body:
    - meta_scope: string.quoted.double.halo
    - match: '\\(["''/\\nrt]|.)'
      scope: constant.character.escape.halo
    - match: '"'
      scope: punctuation.definition.string.end.halo
      pop: true
    - match: '\n'
      pop: true

  string-single-body:
    - meta_scope: string.quoted.single.halo
    - match: '\\(["''/\\nrt]|.)'
      scope: constant.character.escape.halo
    - match: "'"
      scope: punctuation.definition.string.end.halo
      pop: true
    - match: '\n'
      pop: true

  number:
    - match: '\b-?[0-9]+(\.[0-9]+)?\b'
      scope: constant.numeric.halo

  boolean:
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.halo

  keywords:
    - match: '/\*'
      scope: punctuation.definition.comment.begin.halo
      push: block-comment-body
    - match: '\b(as)\b'
      scope: keyword.other.binding.halo
    - match: '\b(policy|tool|store|schema|equips|requires|system)\b'
      scope: storage.type.halo
    - match: '\b(each|in|else)\b'
      scope: keyword.control.flow.halo
    - match: '\b(yield|listen|loop)\b'
      scope: support.function.builtin.halo
    - match: '\b(context)\b'
      scope: variable.language.context.halo
    - match: '\bnull\b'
      scope: constant.language.null.halo
    - match: '\|<>|\|[>?!*]|~>'
      scope: keyword.operator.pipe.halo
    - match: '&&|\|\||!(?!=)|==|!=|>=|<=|=>|[<>&]'
      scope: keyword.operator.logical.halo
    - match: '\b[0-9]+(ms|[smhd])\b'
      scope: constant.numeric.duration.halo

  block-comment-body:
    - meta_scope: comment.block.halo
    - match: '\*/'
      scope: punctuation.definition.comment.end.halo
      pop: true

  triple-string-body:
    - meta_scope: string.quoted.triple.halo
    - match: '"""'
      scope: punctuation.definition.string.end.halo
      pop: true
