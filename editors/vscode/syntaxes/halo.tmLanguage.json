{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Halo",
  "scopeName": "source.halo",
  "fileTypes": [
    ".ly"
  ],
  "foldingStartMarker": "^//\\s*\\{",
  "foldingStopMarker": "^//\\s*\\}",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#block-comment"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#import-keywords"
    },
    {
      "include": "#decl-keywords"
    },
    {
      "include": "#agent-decl"
    },
    {
      "include": "#pipeline-decl"
    },
    {
      "include": "#string"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#number"
    },
    {
      "include": "#boolean"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.halo",
      "begin": "//",
      "end": "$",
      "captures": {
        "0": {
          "name": "punctuation.definition.comment.halo"
        }
      }
    },
    "agent-decl": {
      "begin": "\\b(agent)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.halo"
        },
        "2": {
          "name": "entity.name.type.agent.halo"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.halo"
        }
      },
      "patterns": [
        {
          "include": "#model-config"
        }
      ]
    },
    "model-config": {
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.halo"
        }
      },
      "end": "(?=\\])",
      "patterns": [
        {
          "include": "#model-ref"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": {
              "name": "variable.parameter.halo"
            },
            "2": {
              "name": "keyword.operator.assignment.halo"
            }
          }
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#boolean"
        },
        {
          "match": ",",
          "name": "punctuation.separator.halo"
        }
      ]
    },
    "model-ref": {
      "match": "(?=/?[a-zA-Z_][a-zA-Z0-9_-]*([\\-\\/][a-zA-Z0-9_-]+)*)(/?[a-zA-Z_][a-zA-Z0-9_/-]*)",
      "captures": {
        "1": {
          "name": "entity.name.model.halo"
        }
      }
    },
    "pipeline-decl": {
      "begin": "\\b(pipeline)\\b",
      "beginCaptures": {
        "1": {
          "name": "storage.type.halo"
        }
      },
      "end": "(?=$|\\n(?=\\s*[^ \\t]))",
      "patterns": [
        {
          "include": "#pipeline-body"
        }
      ]
    },
    "pipeline-signature": {
      "begin": "\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\(",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.pipeline.halo"
        }
      },
      "end": "(?=:)",
      "patterns": [
        {
          "include": "#pipeline-params"
        },
        {
          "match": "->",
          "name": "keyword.operator.arrow.halo"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "name": "entity.name.type.halo"
        }
      ]
    },
    "pipeline-params": {
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.parens.begin.halo"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.halo"
        }
      },
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b\\s*(:)\\s*\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "variable.parameter.halo"
            },
            "2": {
              "name": "keyword.operator.assignment.halo"
            },
            "3": {
              "name": "entity.name.type.halo"
            }
          }
        },
        {
          "match": ",",
          "name": "punctuation.separator.halo"
        }
      ]
    },
    "pipeline-body": {
      "patterns": [
        {
          "include": "#pipeline-signature"
        },
        {
          "include": "#pipeline-stages"
        }
      ]
    },
    "pipeline-stages": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#block-comment"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#string"
        },
        {
          "match": "\\|>",
          "name": "keyword.operator.pipe.halo"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\.\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.object.halo"
            },
            "2": {
              "name": "entity.name.function.call.halo"
            }
          }
        },
        {
          "include": "#call-args"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "name": "variable.other.halo"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#boolean"
        }
      ]
    },
    "call-args": {
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.parens.begin.halo"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.halo"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#block-comment"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#boolean"
        },
        {
          "match": ",",
          "name": "punctuation.separator.halo"
        },
        {
          "include": "#call-args"
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": {
              "name": "variable.parameter.halo"
            },
            "2": {
              "name": "keyword.operator.assignment.halo"
            }
          }
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.triple.halo",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "match": "\\{\\{[^}]*\\}\\}",
              "name": "variable.other.interpolation.halo"
            }
          ]
        },
        {
          "name": "string.quoted.double.halo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "match": "\\\\([\"'/\\\\nrt]|.)",
              "name": "constant.character.escape.halo"
            },
            {
              "match": "\\{\\{[^}]*\\}\\}",
              "name": "variable.other.interpolation.halo"
            }
          ],
          "captures": {
            "0": {
              "name": "punctuation.definition.string.halo"
            }
          }
        },
        {
          "name": "string.quoted.single.halo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "match": "\\\\([\"'/\\\\nrt]|.)",
              "name": "constant.character.escape.halo"
            },
            {
              "match": "\\{\\{[^}]*\\}\\}",
              "name": "variable.other.interpolation.halo"
            }
          ],
          "captures": {
            "0": {
              "name": "punctuation.definition.string.halo"
            }
          }
        }
      ]
    },
    "number": {
      "match": "\\b-?[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.halo"
    },
    "boolean": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.halo"
    },
    "block-comment": {
      "name": "comment.block.halo",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "decl-keywords": {
      "match": "\\b(policy|tool|store|schema|equips|requires|system)\\b",
      "name": "storage.type.halo"
    },
    "import-keywords": {
      "match": "^\\s*(use)\\b|\\b(with)(?=\\s+models\\s*\\()",
      "captures": {
        "1": {
          "name": "keyword.control.import.halo"
        },
        "2": {
          "name": "keyword.control.import.halo"
        }
      }
    },
    "directive": {
      "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.annotation.halo"
        },
        "2": {
          "name": "storage.modifier.annotation.halo"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(as)\\b",
          "name": "keyword.other.binding.halo"
        },
        {
          "match": "\\b(each|in|else)\\b",
          "name": "keyword.control.flow.halo"
        },
        {
          "match": "\\b(yield|listen|loop)\\b",
          "name": "support.function.builtin.halo"
        },
        {
          "match": "\\b(context)\\b",
          "name": "variable.language.context.halo"
        },
        {
          "match": "\\bnull\\b",
          "name": "constant.language.null.halo"
        },
        {
          "match": "\\|<>|\\|[>?!*]|~>",
          "name": "keyword.operator.pipe.halo"
        },
        {
          "match": "&&|\\|\\||!(?!=)|==|!=|>=|<=|=>|[<>&]",
          "name": "keyword.operator.logical.halo"
        },
        {
          "match": "\\b[0-9]+(ms|[smhd])\\b",
          "name": "constant.numeric.duration.halo"
        }
      ]
    }
  }
}
