{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Langly",
  "scopeName": "source.langly",
  "fileTypes": [".ly"],
  "foldingStartMarker": "^//\\s*\\{",
  "foldingStopMarker": "^//\\s*\\}",
  "patterns": [
    { "include": "#comment" },
    { "include": "#decorators" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#mind-decl" },
    { "include": "#stream-decl" },
    { "include": "#pipeline-operators" },
    { "include": "#context-vars" },
    { "include": "#function-calls" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#boolean" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.langly",
      "begin": "//",
      "end": "$",
      "captures": {
        "0": { "name": "punctuation.definition.comment.langly" }
      }
    },
    "decorators": {
      "match": "(@)(timeout|retry|shadow)\\b",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.langly" },
        "2": { "name": "entity.name.function.decorator.langly" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(mind|stream|tool|guardrail|struct|memory)\\b",
          "name": "keyword.control.declaration.langly"
        },
        {
          "match": "\\b(equips|requires|loop|listen|yield)\\b",
          "name": "keyword.control.langly"
        }
      ]
    },
    "types": {
      "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b",
      "name": "entity.name.type.langly"
    },
    "mind-decl": {
      "begin": "\\b(mind)\\b\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.declaration.langly" },
        "2": { "name": "entity.name.type.mind.langly" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.section.brackets.end.langly" }
      },
      "patterns": [
        { "include": "#model-config" }
      ]
    },
    "model-config": {
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.section.brackets.begin.langly" }
      },
      "end": "(?=\\])",
      "patterns": [
        { "include": "#model-ref" },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.parameter.langly" },
            "2": { "name": "keyword.operator.assignment.langly" }
          }
        },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#boolean" },
        { "match": ",", "name": "punctuation.separator.langly" }
      ]
    },
    "model-ref": {
      "match": "(?=/?[a-zA-Z_][a-zA-Z0-9_-]*([\\-\\/][a-zA-Z0-9_-]+)*)(/?[a-zA-Z_][a-zA-Z0-9_/-]*)",
      "captures": {
        "1": { "name": "entity.name.model.langly" }
      }
    },
    "stream-decl": {
      "begin": "\\b(stream)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.declaration.langly" }
      },
      "end": "(?=$|\\n(?=\\s*[^ \\t]))",
      "patterns": [
        { "include": "#stream-body" }
      ]
    },
    "stream-signature": {
      "begin": "\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\(",
      "beginCaptures": {
        "1": { "name": "entity.name.function.stream.langly" }
      },
      "end": "(?=:)",
      "patterns": [
        { "include": "#stream-params" },
        { "match": "->", "name": "keyword.operator.arrow.langly" },
        { "include": "#types" }
      ]
    },
    "stream-params": {
      "begin": "\\(",
      "beginCaptures": {
        "0": { "name": "punctuation.section.parens.begin.langly" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.langly" }
      },
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b\\s*(:)\\s*\\b([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.parameter.langly" },
            "2": { "name": "keyword.operator.assignment.langly" },
            "3": { "name": "entity.name.type.langly" }
          }
        },
        { "match": ",", "name": "punctuation.separator.langly" }
      ]
    },
    "stream-body": {
      "patterns": [
        { "include": "#stream-signature" },
        { "include": "#pipeline-stages" }
      ]
    },
    "pipeline-stages": {
      "patterns": [
        { "include": "#pipeline-operators" },
        { "include": "#context-vars" },
        { "include": "#function-calls" },
        { "include": "#keywords" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#boolean" },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "name": "variable.other.langly"
        }
      ]
    },
    "pipeline-operators": {
      "match": "(\\|>|\\|\\?|\\|!|\\|\\*|\\~>|\\|<>)",
      "name": "keyword.control.langly"
    },
    "context-vars": {
      "patterns": [
        {
          "match": "\\b(context)\\b",
          "name": "variable.language.context.langly"
        },
        {
          "match": "\\b(Env)\\.([A-Z_0-9]+)\\b",
          "captures": {
            "1": { "name": "support.class.env.langly" },
            "2": { "name": "constant.other.env.langly" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\.\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.other.object.langly" },
            "2": { "name": "entity.name.function.call.langly" }
          }
        },
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.langly" }
          }
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.langly",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#template-vars" },
            {
              "match": "\\\\([\"'/\\\\nrt]|.)",
              "name": "constant.character.escape.langly"
            }
          ],
          "captures": {
            "0": { "name": "punctuation.definition.string.langly" }
          }
        },
        {
          "name": "string.quoted.single.langly",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#template-vars" },
            {
              "match": "\\\\([\"'/\\\\nrt]|.)",
              "name": "constant.character.escape.langly"
            }
          ],
          "captures": {
            "0": { "name": "punctuation.definition.string.langly" }
          }
        }
      ]
    },
    "template-vars": {
      "match": "(\\{\\{)(.*?)(\\}\\})",
      "captures": {
        "1": { "name": "punctuation.definition.template.begin.langly" },
        "2": { "name": "variable.other.template.langly" },
        "3": { "name": "punctuation.definition.template.end.langly" }
      }
    },
    "number": {
      "match": "\\b-?[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.langly"
    },
    "boolean": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.langly"
    }
  }
}
