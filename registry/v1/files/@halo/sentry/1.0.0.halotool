{"format":"halo-package/2","manifest":{"name":"@halo/sentry","version":"1.0.0","description":"Sentry error tracking: list, read, and resolve issues","license":"MIT","homepage":"https://docs.sentry.io/api/","keywords":["sentry","errors"],"providers":{"Sentry":{"kind":"http","description":"The Sentry API (sentry.io)","baseUrl":"https://sentry.io/api/0","auth":{"type":"bearer","env":"SENTRY_AUTH_TOKEN"},"methods":[{"name":"list_issues","description":"List a project's unresolved issues. query uses Sentry search syntax, e.g. is:unresolved level:error.","effect":"read","http":{"method":"GET","path":"/projects/{organization}/{project}/issues/"},"params":{"type":"object","properties":{"organization":{"type":"string"},"project":{"type":"string"},"query":{"type":"string"},"statsPeriod":{"type":"string","description":"e.g. 24h or 14d"}},"required":["organization","project"]}},{"name":"get_issue","description":"Get an issue's details.","effect":"read","http":{"method":"GET","path":"/organizations/{organization}/issues/{issue_id}/"}},{"name":"latest_event","description":"Get an issue's latest event, with its stack trace.","effect":"read","http":{"method":"GET","path":"/organizations/{organization}/issues/{issue_id}/events/latest/"}},{"name":"update_issue","description":"Change an issue's status (resolved, unresolved, ignored) or assignee.","effect":"external","http":{"method":"PUT","path":"/organizations/{organization}/issues/{issue_id}/"},"params":{"type":"object","properties":{"organization":{"type":"string"},"issue_id":{"type":"string"},"status":{"type":"string","enum":["resolved","unresolved","ignored"]},"assignedTo":{"type":"string"}},"required":["organization","issue_id"]}}]}}},"files":{"README.md":"","halo.json":""}}