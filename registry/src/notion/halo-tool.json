{
  "name": "notion",
  "version": "1.0.0",
  "description": "Notion pages and databases: search, read, query, create, and append",
  "publisher": "Halo (first-party)",
  "homepage": "https://developers.notion.com/reference",
  "license": "MIT",
  "providers": {
    "Notion": {
      "kind": "http",
      "description": "The Notion API (the integration sees only pages shared with it)",
      "baseUrl": "https://api.notion.com/v1",
      "auth": { "type": "bearer", "env": "NOTION_API_KEY" },
      "headers": { "Notion-Version": "2022-06-28" },
      "methods": [
        {
          "name": "search",
          "description": "Search pages and databases by title.",
          "effect": "read",
          "http": { "method": "POST", "path": "/search" },
          "params": { "type": "object", "properties": { "query": { "type": "string" }, "page_size": { "type": "integer" } } }
        },
        {
          "name": "get_page",
          "description": "Get a page's properties.",
          "effect": "read",
          "http": { "method": "GET", "path": "/pages/{page_id}" }
        },
        {
          "name": "get_blocks",
          "description": "Get a page's content (its child blocks).",
          "effect": "read",
          "http": { "method": "GET", "path": "/blocks/{block_id}/children" }
        },
        {
          "name": "query_database",
          "description": "Query a database's rows, with an optional Notion filter and sorts.",
          "effect": "read",
          "http": { "method": "POST", "path": "/databases/{database_id}/query" },
          "params": {
            "type": "object",
            "properties": { "database_id": { "type": "string" }, "filter": { "type": "object" }, "sorts": { "type": "array", "items": { "type": "object" } }, "page_size": { "type": "integer" } },
            "required": ["database_id"]
          }
        },
        {
          "name": "create_page",
          "description": "Create a page under a parent page or database. parent is {\"page_id\": ...} or {\"database_id\": ...}; properties follow Notion's format.",
          "effect": "external",
          "http": { "method": "POST", "path": "/pages" },
          "params": {
            "type": "object",
            "properties": { "parent": { "type": "object" }, "properties": { "type": "object" }, "children": { "type": "array", "items": { "type": "object" } } },
            "required": ["parent", "properties"]
          }
        },
        {
          "name": "append_blocks",
          "description": "Append blocks (paragraphs, headings, ...) to a page.",
          "effect": "external",
          "http": { "method": "PATCH", "path": "/blocks/{block_id}/children" },
          "params": { "type": "object", "properties": { "block_id": { "type": "string" }, "children": { "type": "array", "items": { "type": "object" } } }, "required": ["block_id", "children"] }
        }
      ]
    }
  }
}
