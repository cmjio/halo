{
  "name": "@halo/cloudflare",
  "version": "1.0.0",
  "description": "Cloudflare: Workers, KV, D1, R2, Pages and Queues in an account; DNS records, settings and cache purges in a zone",
  "license": "MIT",
  "homepage": "https://developers.cloudflare.com/api/",
  "keywords": [
    "cloudflare",
    "workers",
    "dns"
  ],
  "providers": {
    "Cloudflare": {
      "kind": "http",
      "description": "One Cloudflare account's Workers, KV, D1, R2, Pages and Queues (declare with your account ID)",
      "baseUrl": "https://api.cloudflare.com/client/v4/accounts/{{account}}",
      "auth": {
        "type": "bearer",
        "env": "CLOUDFLARE_API_TOKEN"
      },
      "methods": [
        {
          "name": "list_workers",
          "description": "List the account's Worker scripts.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/workers/scripts"
          }
        },
        {
          "name": "get_worker_settings",
          "description": "Get a Worker's settings: bindings, compatibility date and flags, observability.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/workers/scripts/{script_name}/settings"
          }
        },
        {
          "name": "list_worker_deployments",
          "description": "List a Worker's deployments, newest first, with the versions each one serves.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/workers/scripts/{script_name}/deployments"
          }
        },
        {
          "name": "list_kv_namespaces",
          "description": "List the account's KV namespaces.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/storage/kv/namespaces"
          },
          "params": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer",
                "description": "Up to 1000"
              }
            }
          }
        },
        {
          "name": "list_kv_keys",
          "description": "List a KV namespace's keys. Pass the result's cursor to get the next page.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/storage/kv/namespaces/{namespace_id}/keys"
          },
          "params": {
            "type": "object",
            "properties": {
              "namespace_id": {
                "type": "string"
              },
              "prefix": {
                "type": "string"
              },
              "limit": {
                "type": "integer",
                "description": "10 to 1000"
              },
              "cursor": {
                "type": "string"
              }
            },
            "required": [
              "namespace_id"
            ]
          }
        },
        {
          "name": "get_kv_value",
          "description": "Read the value stored under a key in a KV namespace.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/storage/kv/namespaces/{namespace_id}/values/{key_name}"
          }
        },
        {
          "name": "delete_kv_value",
          "description": "Delete a key from a KV namespace.",
          "effect": "external",
          "http": {
            "method": "DELETE",
            "path": "/storage/kv/namespaces/{namespace_id}/values/{key_name}"
          }
        },
        {
          "name": "list_d1_databases",
          "description": "List the account's D1 databases.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/d1/database"
          },
          "params": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Filter by name"
              }
            }
          }
        },
        {
          "name": "query_d1",
          "description": "Run SQL against a D1 database, with ? placeholders filled from params. It can change data, so it counts as external even for a SELECT.",
          "effect": "external",
          "http": {
            "method": "POST",
            "path": "/d1/database/{database_id}/query"
          },
          "params": {
            "type": "object",
            "properties": {
              "database_id": {
                "type": "string"
              },
              "sql": {
                "type": "string"
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "database_id",
              "sql"
            ]
          }
        },
        {
          "name": "list_r2_buckets",
          "description": "List the account's R2 buckets.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/r2/buckets"
          },
          "params": {
            "type": "object",
            "properties": {
              "name_contains": {
                "type": "string"
              }
            }
          }
        },
        {
          "name": "list_pages_projects",
          "description": "List the account's Pages projects.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/pages/projects"
          }
        },
        {
          "name": "list_pages_deployments",
          "description": "List a Pages project's deployments, newest first, with their status and URL.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/pages/projects/{project_name}/deployments"
          },
          "params": {
            "type": "object",
            "properties": {
              "project_name": {
                "type": "string"
              },
              "env": {
                "type": "string",
                "enum": [
                  "production",
                  "preview"
                ]
              }
            },
            "required": [
              "project_name"
            ]
          }
        },
        {
          "name": "list_queues",
          "description": "List the account's Queues, with their producers and consumers.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/queues"
          }
        }
      ]
    },
    "CloudflareZone": {
      "kind": "http",
      "description": "One Cloudflare zone's DNS records, settings and cache (declare with its zone ID)",
      "baseUrl": "https://api.cloudflare.com/client/v4/zones/{{zone}}",
      "auth": {
        "type": "bearer",
        "env": "CLOUDFLARE_API_TOKEN"
      },
      "methods": [
        {
          "name": "list_dns_records",
          "description": "List the zone's DNS records, optionally filtered by type, exact name, or content.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/dns_records"
          },
          "params": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "e.g. A, AAAA, CNAME, TXT, MX"
              },
              "name": {
                "type": "string",
                "description": "The full name, e.g. www.example.com"
              },
              "content": {
                "type": "string"
              },
              "page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer"
              }
            }
          }
        },
        {
          "name": "create_dns_record",
          "description": "Create a DNS record. ttl 1 means automatic; proxied puts it behind Cloudflare.",
          "effect": "external",
          "http": {
            "method": "POST",
            "path": "/dns_records"
          },
          "params": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "ttl": {
                "type": "integer"
              },
              "proxied": {
                "type": "boolean"
              },
              "priority": {
                "type": "integer",
                "description": "For MX records"
              },
              "comment": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "name",
              "content"
            ]
          }
        },
        {
          "name": "update_dns_record",
          "description": "Change some fields of a DNS record (the rest stay as they are).",
          "effect": "external",
          "http": {
            "method": "PATCH",
            "path": "/dns_records/{dns_record_id}"
          },
          "params": {
            "type": "object",
            "properties": {
              "dns_record_id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "ttl": {
                "type": "integer"
              },
              "proxied": {
                "type": "boolean"
              },
              "comment": {
                "type": "string"
              }
            },
            "required": [
              "dns_record_id"
            ]
          }
        },
        {
          "name": "delete_dns_record",
          "description": "Delete a DNS record.",
          "effect": "external",
          "http": {
            "method": "DELETE",
            "path": "/dns_records/{dns_record_id}"
          }
        },
        {
          "name": "get_setting",
          "description": "Read one zone setting, e.g. ssl, always_use_https, min_tls_version, cache_level, development_mode.",
          "effect": "read",
          "http": {
            "method": "GET",
            "path": "/settings/{setting_id}"
          }
        },
        {
          "name": "purge_cache",
          "description": "Purge cached content: by files (full URLs), by prefixes, by hosts, or everything with purge_everything: true.",
          "effect": "external",
          "http": {
            "method": "POST",
            "path": "/purge_cache"
          },
          "params": {
            "type": "object",
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prefixes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "purge_everything": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    }
  }
}
