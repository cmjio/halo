{
  "name": "halo",
  "version": "0.1.0",
  "description": "Halo: a declarative language for AI workflows",
  "type": "module",
  "main": "./index.ts",
  "bin": {
    "halo": "./index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit && bunx tsc -p studio/tsconfig.json",
    "generate": "bash generate-grammar.sh",
    "validate": "bun run index.ts validate examples/",
    "build": "bun build index.ts --target bun --outdir ./dist",
    "build:zed": "bash editors/zed/build.sh",
    "build:vsx": "bun build src/lsp/server.ts --target node --outfile editors/vscode/server.js && cd editors/vscode && npm run compile",
    "package:vsx": "bun run build:vsx && cd editors/vscode && bunx vsce package",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "studio": "bun run index.ts serve"
  },
  "keywords": [
    "ai",
    "llm",
    "dsl",
    "workflow",
    "pipeline"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./parser": "./src/parser/index.ts",
    "./runtime": "./src/runtime/runtime.ts",
    "./adapter": "./src/runtime/adapter.ts",
    "./router": "./src/runtime/router.ts",
    "./errors": "./src/errors.ts",
    "./telemetry": "./src/runtime/telemetry.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "antlr4ng": "^3.0.16",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "antlr4ng-cli": "^2.0.0",
    "bun-types": "latest",
    "vitepress": "^1.2.2",
    "vue": "^3.4.27"
  }
}
