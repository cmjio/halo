// ============================================================
// STEP 38: Local Automation & Web Fetching
// ============================================================
// LEARN: How to build autonomous computer agents
// WHY:   Agents are useless without real world capabilities.
//        Langly natively supports bash execution and web parsing.
// ============================================================

// 1. Define the real local tools
tool Reader : Browser(mode: "fetch")
tool Shell  : Bash()

// 2. Equip the tools to an agent
agent Assistant [openai/gpt-4o, temp: 0.1]
  equips Reader, Shell

// 3. Define the pipeline
pipeline SummarizeWebsite(url: String) -> Result:
  url
    // 1. The Browser tool fetches the raw HTML, automatically strips out 
    //    script tags and CSS, and returns clean readable text.
    |> Reader.execute()

    // 2. The LLM reads the scraped website and summarizes it
    |> Assistant.prompt("Summarize the following website content in one sentence.")
    
    // 3. We pass the summary into a real bash script to write it to disk!
    |> Shell.execute(command: "echo '{{context.current}}' > .website_summary.txt")
    
    // 4. Verify it wrote correctly
    |> Shell.execute(command: "cat .website_summary.txt")
    |> System.Print()

// ============================================================
// HOW IT WORKS UNDER THE HOOD:
// 1. The BrowserTool uses native Fetch to hit the URL.
// 2. The BashTool uses `Bun.spawn` to securely execute commands 
//    on your local machine and captures stdout/stderr.
// 3. Langly automatically interpolates variables like `{{context.current}}`
//    directly into the bash command before execution.
// ============================================================
