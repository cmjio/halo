// ============================================================
// STEP 16: Retry & Checkpoint Directives
// ============================================================
// LEARN: How to add resilience with @retry and @checkpoint
// WHY:  Handle transient failures, save intermediate state
// ============================================================

agent Resilient [openai/gpt-4o, temp: 0.7]

// Retry directive: retry up to 3 times, wait 5s between retries
@retry(3, 5s)
// Checkpoint: save the run after every stage, and keep every step
@checkpoint
pipeline RobustCall(data: String) -> Result:
  data
    |> Resilient.prompt("Process: {{data}}")
    // If this fails, retries happen automatically
    |> System.Print()

// Retry syntax: @retry(count, delay)
//   count: number of retry attempts
//   delay: time to wait between retries (e.g., 5s, 1m)
//
// Checkpoint syntax: @checkpoint
//   Saves the run to .halo/checkpoints/<Pipeline>-<runId>.json after every
//   stage, and adds each step to <Pipeline>-<runId>.steps.jsonl beside it.
//
//   halo run examples/learn/16-retry-checkpoint.halo --checkpoint <file>   continue a stopped run
//   halo history <runId>                       list every step
//   halo history <runId> --step 1              the run's state after step 1
//   halo rewind examples/learn/16-retry-checkpoint.halo <runId> --step 1   continue from step 1 as a new run
